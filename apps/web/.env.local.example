# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me
# Slack app client_id / client_secret (Basic Information -> App Credentials)
AUTH_SLACK_ID=your-slack-client-id
AUTH_SLACK_SECRET=your-slack-client-secret
# Must match the port the dashboard actually serves on:
AUTH_URL=http://localhost:3000
# optional — enables Slack celebration posts on reward redemption;
# reuse the bot token from apps/slack/.env. Leave unset to disable.
SLACK_BOT_TOKEN=
SLACK_KUDOS_CHANNEL=""  # e.g. "#kudos" — keep the quotes, dotenv treats unquoted # as a comment
# /setup is unlisted (URL only). Dev: always reachable. Prod: reachable by an
# admin (User.isAdmin) OR via this bootstrap flag. Set to "true" only to reach
# /setup on a fresh deploy before anyone can sign in — bootstrap only; unset it
# once you've flipped isAdmin on your account.
# ENABLE_SETUP_PAGE="true"
