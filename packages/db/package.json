{
  "name": "@kudos/db",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "generate": "DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\" prisma generate",
    "push": "DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\" prisma db push",
    "seed": "tsx prisma/seed.ts",
    "demo": "tsx prisma/demo-seed.ts",
    "test": "vitest run",
    "pg:schema": "tsx scripts/gen-postgres-schema.ts",
    "pg:schema:check": "tsx scripts/gen-postgres-schema.ts --check",
    "pg:generate": "prisma generate --schema=prisma/schema.postgres.prisma",
    "pg:migrate": "prisma migrate deploy --schema=prisma/schema.postgres.prisma"
  },
  "dependencies": { "@prisma/client": "^5.20.0" },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
